{
  "name": "ai-interview-coach",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source, adaptive AI interview practice with natural conversation and recruiter-quality feedback.",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "build": "turbo run build",
    "container:down": "docker compose down",
    "container:logs": "docker compose logs --follow web",
    "container:up": "docker compose up --build --detach --wait",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "^5.9.3"
  }
}
