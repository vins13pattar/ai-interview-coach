# Optional server-managed provider keys. The demo works without any keys.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional encrypted server-side BYOK storage. Generate with `openssl rand -base64 32`.
# Losing or rotating this key without a migration makes stored provider keys unreadable.
PROVIDER_ENCRYPTION_KEY=

# Optional LangSmith tracing. Never expose these values to the browser.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-interview-coach

# Required when enabling durable production sessions.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/interview_coach
DATABASE_POOL_MAX=10

# Browser origin and cookie policy. Keep secure=false only for local HTTP.
APP_ORIGIN=http://localhost:3000
SESSION_COOKIE_SECURE=false

# Local Compose database settings. Replace them outside local development.
POSTGRES_DB=interview_coach
POSTGRES_USER=interview_coach
POSTGRES_PASSWORD=interview_coach

# Container settings. PORT is the host port; the container always listens on 3000.
PORT=3000
IMAGE_TAG=local
APP_VERSION=development
