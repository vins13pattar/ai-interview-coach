# Provider calls are candidate-funded BYOK only. The demo works without keys.
ANTHROPIC_API_KEY=

# Optional OpenAI Realtime voice defaults. These are identifiers, not secrets.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin

# Optional encrypted server-side BYOK storage. Generate with `openssl rand -base64 32`.
# Losing or rotating this key without a migration makes stored provider keys unreadable.
PROVIDER_ENCRYPTION_KEY=

# Optional LangSmith tracing. Never expose these values to the browser.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-interview-coach

# Required when enabling durable production sessions.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/interview_coach
DATABASE_POOL_MAX=10

# Browser origin and cookie policy. Keep secure=false only for local HTTP.
APP_ORIGIN=http://localhost:3000
SESSION_COOKIE_SECURE=false

# Required for the authenticated daily Vercel retention job in hosted deployments.
# Generate with `openssl rand -base64 32`; do not expose it to the browser.
CRON_SECRET=

# Hosted abuse and retention controls. Values below are the built-in defaults.
GUEST_SESSION_LIMIT_PER_MINUTE=3
GUEST_SESSION_LIMIT_PER_DAY=5
GUEST_TURN_LIMIT_PER_MINUTE=12
GUEST_TURN_LIMIT_PER_DAY=75
REGISTERED_SESSION_LIMIT_PER_MINUTE=5
REGISTERED_SESSION_LIMIT_PER_DAY=25
REGISTERED_TURN_LIMIT_PER_MINUTE=20
REGISTERED_TURN_LIMIT_PER_DAY=500
GUEST_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=30
RETENTION_BATCH_SIZE=100

# Local Compose database settings. Replace them outside local development.
POSTGRES_DB=interview_coach
POSTGRES_USER=interview_coach
POSTGRES_PASSWORD=interview_coach

# Container settings. PORT is the host port; the container always listens on 3000.
PORT=3000
IMAGE_TAG=local
APP_VERSION=development
